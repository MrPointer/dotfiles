{{- $nvmRelease := (gitHubLatestRelease "nvm-sh/nvm").TagName | toString -}}

[".local/share/nvim/site/autoload/plug.vim"]
type = "file"
url = "https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim"
refreshPeriod = "168h"

[".local/share/zsh/functions/git.zsh"]
type = "file"
url = "https://github.com/ohmyzsh/ohmyzsh/raw/refs/heads/master/lib/git.zsh"
refreshPeriod = "168h"

[".local/share/zsh/plugins/git/git.plugin.zsh"]
type = "file"
url = "https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/refs/heads/master/plugins/git/git.plugin.zsh"
refreshPeriod = "168h"

[".local/share/zsh/plugins/dotenv/dotenv.plugin.zsh"]
type = "file"
url = "https://github.com/ohmyzsh/ohmyzsh/raw/refs/heads/master/plugins/dotenv/dotenv.plugin.zsh"
refreshPeriod = "168h"

[".local/share/zsh/plugins/key-bindings/key-bindings.plugin.zsh"]
type = "file"
url = "https://github.com/ohmyzsh/ohmyzsh/raw/refs/heads/master/lib/key-bindings.zsh"
refreshPeriod = "168h"

[".config/eza/theme.yml"]
type = "file"
url = "https://raw.githubusercontent.com/eza-community/eza-themes/refs/heads/main/themes/tokyonight.yml"
refreshPeriod = "168h"

[".nvm/nvm.sh"]
type = "file"
url = "https://raw.githubusercontent.com/nvm-sh/nvm/{{ $nvmRelease }}/nvm.sh"
refreshPeriod = "168h"

[".nvm/nvm-exec"]
type = "file"
url = "https://raw.githubusercontent.com/nvm-sh/nvm/{{ $nvmRelease }}/nvm-exec"
executable = true
refreshPeriod = "168h"

[".nvm/bash_completion"]
type = "file"
url = "https://raw.githubusercontent.com/nvm-sh/nvm/{{ $nvmRelease }}/bash_completion"
refreshPeriod = "168h"
