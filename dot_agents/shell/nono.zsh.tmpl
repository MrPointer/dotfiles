# Shared helpers for coding agents launched through nono.

function _nono_agent_ensure_ssh_signing_key() {
  local public_key="$1"
  local private_key="${2:-${public_key%.pub}}"

  [[ -n "${SSH_AUTH_SOCK:-}" ]] || return 0
  command -v ssh-add >/dev/null 2>&1 || return 0
  [[ -r "$public_key" ]] || return 0

  ssh-add -T "$public_key" >/dev/null 2>&1 && return 0
  [[ -r "$private_key" ]] || return 0

{{- if eq .chezmoi.os "darwin" }}
  ssh-add --apple-use-keychain "$private_key" >/dev/null 2>&1 || ssh-add -q "$private_key" || true
{{- else }}
  ssh-add -q "$private_key" || true
{{- end }}
}

function _nono_agent_run() {
  local profile="$1"
  local git_config="$2"
  local command_name="$3"
  local public_key="$4"
  local private_key="$5"
  shift 5

  _nono_agent_ensure_ssh_signing_key "$public_key" "$private_key"

  local -a ssh_agent_args=()
  if [[ -n "${SSH_AUTH_SOCK:-}" ]]; then
    ssh_agent_args=(--allow-unix-socket "$SSH_AUTH_SOCK")
  fi

  # Deck (VS Code agent manager) hosts agents in a `tmux -L deck` server and
  # renames its window via the socket; only granted when running under Deck.
  local -a deck_socket_args=()
  if [[ -n "${DECK_SESSION:-}" ]]; then
    deck_socket_args=(--allow-unix-socket "${TMUX_TMPDIR:-/tmp}/tmux-${UID}/deck")
  fi

  local -a git_common_dir_args=()
  local git_common_dir
  if git_common_dir="$(command git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"; then
    # The folder holding .git is the main checkout, or in the bare worktree
    # layout (git wtclone) the container of every worktree. Never widen to
    # $HOME or / when a repository lives there.
    if [[ "${git_common_dir:t}" == .git && "${git_common_dir:h}" != "$HOME" && "${git_common_dir:h}" != / ]]; then
      git_common_dir_args=(--allow "${git_common_dir:h}")
    else
      git_common_dir_args=(--allow "$git_common_dir")
    fi

    # A classic (non-bare) clone keeps its worktrees in a central folder keyed
    # by the main checkout path, matching the worktree-path template that
    # run_after_ensure-worktrunk-config.sh writes for worktrunk.
    if [[ "$(command git --git-dir="$git_common_dir" config --bool core.bare 2>/dev/null)" != true ]]; then
      local main_checkout
      main_checkout="$(command git worktree list --porcelain 2>/dev/null | command sed -n '1s/^worktree //p')"
      if [[ -n "$main_checkout" ]]; then
        local worktrees_dir="$HOME/.local/share/worktrees/${${main_checkout//[\/\\]/-}//./-}"
        command mkdir -p "$worktrees_dir" &&
          git_common_dir_args+=(--allow "$worktrees_dir")
      fi
    fi
  fi

  local -a acp_args=()
  if [[ "${NONO_AGENT_ACP:-}" == 1 ]]; then
    acp_args=(--silent --startup-timeout 0)
  fi
  if [[ "$command_name" == opencode && "${1:-}" == acp ]]; then
    acp_args=(--silent --startup-timeout 0)
  fi

  GIT_CONFIG_GLOBAL="$git_config" \
    nono run \
    --profile "$profile" \
    --allow-cwd \
    "${acp_args[@]}" \
    "${git_common_dir_args[@]}" \
    "${ssh_agent_args[@]}" \
    "${deck_socket_args[@]}" \
    -- "$command_name" "$@"
}
