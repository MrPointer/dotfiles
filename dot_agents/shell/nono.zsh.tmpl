# Shared helpers for coding agents launched through nono.

# Records opt-in sandbox features per profile. Agent shell files declare them
# next to the launchers that name each profile, so every launch path that
# sources those files (interactive shells and nono-agent-acp) sees the same set.
typeset -gA _NONO_AGENT_FEATURES

function _nono_agent_enable() {
  local profile="$1"
  local feature="$2"

  _nono_agent_has_feature "$profile" "$feature" ||
    _NONO_AGENT_FEATURES[$profile]+=" $feature "
}

function _nono_agent_has_feature() {
  [[ "${_NONO_AGENT_FEATURES[$1]:-}" == *" $2 "* ]]
}

function _nono_agent_ensure_ssh_signing_key() {
  local public_key="$1"
  local private_key="${2:-${public_key%.pub}}"

  [[ -n "${SSH_AUTH_SOCK:-}" ]] || return 0
  command -v ssh-add >/dev/null 2>&1 || return 0
  [[ -r "$public_key" ]] || return 0

  ssh-add -T "$public_key" >/dev/null 2>&1 && return 0
  [[ -r "$private_key" ]] || return 0

{{- if eq .chezmoi.os "darwin" }}
  ssh-add --apple-use-keychain "$private_key" >/dev/null 2>&1 || ssh-add -q "$private_key" || true
{{- else }}
  ssh-add -q "$private_key" || true
{{- end }}
}

# Prints nono arguments that grant the Docker daemon socket of each installed
# Docker runtime. The socket gives full control of the host's Docker engine, so
# a socket is granted only when its runtime is installed and the path is a real
# socket (not a symlink) owned by this user and not writable by group or others.
# Grants target the real socket paths: /var/run/docker.sock is only a symlink to
# one of them.
function _nono_agent_docker_args() {
  local -a candidates=()
{{- if eq .chezmoi.os "darwin" }}
  if [[ -d /Applications/OrbStack.app || -d "$HOME/Applications/OrbStack.app" ]]; then
    candidates+=("$HOME/.orbstack/run/docker.sock")
  fi
  if [[ -d /Applications/Docker.app || -d "$HOME/Applications/Docker.app" ]]; then
    candidates+=("$HOME/.docker/run/docker.sock")
  fi
{{- else }}
  if [[ -d /opt/docker-desktop ]]; then
    candidates+=("$HOME/.docker/desktop/docker.sock")
  fi
{{- end }}
  if (( $+commands[colima] )); then
    candidates+=("${COLIMA_HOME:-$HOME/.colima}/default/docker.sock")
  fi

  local socket
  local -a trusted
  for socket in "${candidates[@]}"; do
    # Glob qualifiers check the path itself without following symlinks:
    # = socket, U owned by this user, f:go-w: no group or other write bit.
    trusted=("$socket"(N=Uf:go-w:))
    (( ${#trusted} )) || continue
    # Docker Desktop sockets live under ~/.docker, which nono denies by default.
    print -rl -- --allow-unix-socket "$socket" --bypass-protection "$socket"
  done
}

function _nono_agent_run() {
  local profile="$1"
  local command_name="$2"
  local public_key="$3"
  local private_key="$4"
  shift 4

  _nono_agent_ensure_ssh_signing_key "$public_key" "$private_key"

  local -a ssh_agent_args=()
  if [[ -n "${SSH_AUTH_SOCK:-}" ]]; then
    ssh_agent_args=(--allow-unix-socket "$SSH_AUTH_SOCK")
  fi

  # Deck (VS Code agent manager) hosts agents in a `tmux -L deck` server and
  # renames its window via the socket; only granted when running under Deck.
  local -a deck_socket_args=()
  if [[ -n "${DECK_SESSION:-}" ]]; then
    deck_socket_args=(--allow-unix-socket "${TMUX_TMPDIR:-/tmp}/tmux-${UID}/deck")
  fi

  # Docker-enabled profiles use a dedicated Docker client config without
  # registry logins instead of ~/.docker, which nono denies. That config is
  # read-only inside the sandbox, so buildx keeps its state in a separate
  # writable folder.
  local -a docker_args=()
  if _nono_agent_has_feature "$profile" docker; then
    docker_args=(${(f)"$(_nono_agent_docker_args)"})

    local docker_config="$HOME/.config/docker-agent"
    if [[ -d "$docker_config" ]]; then
      local -x DOCKER_CONFIG="$docker_config"
      docker_args+=(--read "$docker_config")
    fi

    local -x BUILDX_CONFIG="${XDG_CACHE_HOME:-$HOME/.cache}/docker-agent/buildx"
    command mkdir -p "$BUILDX_CONFIG" &&
      docker_args+=(--allow "$BUILDX_CONFIG")

    # Builds run through buildx fetch registry tokens from the client side,
    # inside the sandbox, so Docker Hub's token service must pass the proxy.
    docker_args+=(--allow-domain auth.docker.io)
  fi

  local -a git_common_dir_args=()
  local git_common_dir
  if git_common_dir="$(command git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"; then
    # The folder holding .git is the main checkout, or in the bare worktree
    # layout (git wtclone) the container of every worktree. Never widen to
    # $HOME or / when a repository lives there.
    if [[ "${git_common_dir:t}" == .git && "${git_common_dir:h}" != "$HOME" && "${git_common_dir:h}" != / ]]; then
      git_common_dir_args=(--allow "${git_common_dir:h}")
    else
      git_common_dir_args=(--allow "$git_common_dir")
    fi

    # A classic (non-bare) clone keeps its worktrees in a central folder keyed
    # by the main checkout path, matching the worktree-path template that
    # private_dot_config/worktrunk/modify_config.toml writes for worktrunk.
    if [[ "$(command git --git-dir="$git_common_dir" config --bool core.bare 2>/dev/null)" != true ]]; then
      local main_checkout
      main_checkout="$(command git worktree list --porcelain 2>/dev/null | command sed -n '1s/^worktree //p')"
      if [[ -n "$main_checkout" ]]; then
        local worktrees_dir="$HOME/.local/share/worktrees/${${main_checkout//[\/\\]/-}//./-}"
        command mkdir -p "$worktrees_dir" &&
          git_common_dir_args+=(--allow "$worktrees_dir")
      fi
    fi
  fi

  local -a acp_args=()
  if [[ "${NONO_AGENT_ACP:-}" == 1 ]]; then
    acp_args=(--silent --startup-timeout 0)
  fi
  if [[ "$command_name" == opencode && "${1:-}" == acp ]]; then
    acp_args=(--silent --startup-timeout 0)
  fi

  GIT_CONFIG_GLOBAL="$HOME/.config/git/agent.gitconfig" \
    nono run \
    --profile "$profile" \
    --allow-cwd \
    "${acp_args[@]}" \
    "${git_common_dir_args[@]}" \
    "${ssh_agent_args[@]}" \
    "${deck_socket_args[@]}" \
    "${docker_args[@]}" \
    -- "$command_name" "$@"
}
