#!/usr/bin/env bash
# chezmoi modify_ script for ~/.claude/settings.json.
#
# Claude Code owns this file and writes to it (theme, model, permissions, its
# own hooks). chezmoi must not clobber it. This script receives the current
# target contents on stdin and prints the desired contents on stdout, so it
# only ever sets our UserPromptSubmit hooks and leaves every other key alone.
#
# It is idempotent: any prior group that references one of our commands is
# dropped before ours are appended, so re-running never duplicates an entry and
# never removes hooks that Claude Code added.
set -euo pipefail

hook_cmds=(
  "$HOME/.claude/hooks/reinforce-strict-output-style.sh"
  "$HOME/.claude/hooks/reinforce-git-consent.sh"
)

current="$(cat)"
[ -z "$current" ] && current='{}'

printf '%s' "$current" | jq --args '
  $ARGS.positional as $cmds
  | .hooks.UserPromptSubmit = (
    ((.hooks.UserPromptSubmit // [])
      | map(select([.hooks[]?.command] | any(. as $c | $cmds | index($c)) | not)))
    + [$cmds[] | {hooks: [{type: "command", command: .}]}]
  )
' "${hook_cmds[@]}"
