[user]
   name = {{ .personal.full_name }}
   email = {{ .personal.email }}
   useConfigOnly = true
[branch]
   sort = committerdate
[pull]
   rebase = true
[rebase]
   autosquash = true
   autostash = true
[merge]
   conflictstyle = zdiff3
[submodule]
   recurse = true
[core]
   autocrlf = input
   editor = nvim
   pager = diff-so-fancy | less --tabs=4 -RFX
[diff]
   algorithm = histogram
   external = difft
[grep]
   patternType = perl
[alias]
   exe = update-index --chmod=+x
   root = rev-parse --show-toplevel

   # `git log` with patches shown with difftastic.
   dl = -c diff.external=difft log -p --ext-diff

   # Show the most recent commit with difftastic.
   ds = -c diff.external=difft show --ext-diff

   # `git diff` with difftastic.
   dft = -c diff.external=difft diff
[commit]
   gpgSign = true
[gpg "ssh"]
   allowedSignersFile = {{ .chezmoi.homeDir }}/.config/git/allowed_signers
{{ if .personal.work_env -}}
{{ range $host := list "gitlab.solaredge.com" "ssh.dev.azure.com" -}}
[includeIf "hasconfig:remote.*.url:*@{{ $host }}:*/**"]
   path = {{ $.chezmoi.homeDir }}/.config/git/work.gitconfig
[includeIf "hasconfig:remote.*.url:ssh://*@{{ $host }}/**"]
   path = {{ $.chezmoi.homeDir }}/.config/git/work.gitconfig
{{ end -}}
{{ range $host := list "gitlab.solaredge.com" "dev.azure.com" -}}
{{ range $scheme := list "https" "http" -}}
[includeIf "hasconfig:remote.*.url:{{ $scheme }}://{{ $host }}/**"]
   path = {{ $.chezmoi.homeDir }}/.config/git/work.gitconfig
[includeIf "hasconfig:remote.*.url:{{ $scheme }}://*@{{ $host }}/**"]
   path = {{ $.chezmoi.homeDir }}/.config/git/work.gitconfig
{{ end -}}
{{ end -}}
{{ end -}}
