{
   "$schema": "../schemas/nono-profile.schema.json",
   "extends": [
      "my-claude-code"
   ],
   "meta": {
      "name": "claude-code-rust",
      "description": "Profile for developing Rust applications with Claude Code"
   },
   "groups": {
      "include": [
         "rust_runtime"
      ]
   },
   "network": {
      "block": false,
      "allow_domain": [],
      // Undocumented in schema, but proven to work
      // The range is what MacOS assigns to ephemeral ports
      "open_port_range": [
         [
            49152,
            65535
         ]
      ],
      "listen_port": [
         50002 // HEC serves an HTTP server here
      ]
   }
}
